# Mock-first default for local and v0.1-alpha deploy.
AI_PROVIDER=mock

# Optional: protects /workspace and internal app APIs when configured.
SENSEI_PRIVATE_ACCESS_PASSWORD=

# Optional: required only for Supabase-backed auth and remote chat history.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enable only when Gemini quota/billing is available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Local in-memory usage guardrails.
DAILY_TOKEN_LIMIT=100000
DAILY_COST_LIMIT_USD=1.00
DAILY_AI_REQUEST_LIMIT=20
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=600
AI_ESTIMATED_COST_USD_PER_1K_TOKENS=0
